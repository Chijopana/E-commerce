# Copia este fichero a .env y ajusta lo que necesites.

# SQLite: un solo fichero, sin servidor que instalar.
# Para Postgres: DATABASE_URL="postgresql://usuario:clave@host:5432/tienda"
DATABASE_URL="file:./dev.db"

# Clave de firma de los JWT.
# EN PRODUCCION: generar una propia y no subirla nunca al repositorio.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esta-clave-en-produccion-por-una-aleatoria-y-larga"
JWT_EXPIRES_IN="7d"

PORT=3000

# Origenes permitidos por CORS, separados por comas.
CORS_ORIGINS="http://localhost:4200"
